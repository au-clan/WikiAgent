[2023-10-27 18:46:38,334][HYDRA] nfs_dir: /dlabdata1
work_dir: ${nfs_dir}/charneca/WikiNav
data_dir: ${work_dir}/data
logs_dir: ${work_dir}/logs
agent_runs_file: ${hydra:runtime.output_dir}/agent_runs.tsv
paths_real_file: ${data_dir}/wikispeedia/wikispeedia_paths-and-graph/paths_real_processed.tsv
links_file: ${data_dir}/wikispeedia/wikispeedia_paths-and-graph/links.tsv
pages_folder: ${data_dir}/wpcd/wp/
experiment_name: inference
run_name: completion_test
experiment:
  num_agents: 100
  src: Flamingo
  tgt: Gold(III)_chloride
  debug_mode: false
model:
  _target_: models.huggingface_model.HuggingFaceModel
  model_provider: huggingface
  model_name: meta-llama/Llama-2-7b-hf
  model_path: ${nfs_dir}/llama2_hf/Llama-2-7b-hf/
  temperature: 0.7
  half_precision: true
  num_threads: 16
  batch_size: 1
  top_p: 1
  do_sample: true
  device: cuda
  stop: '}'
agent:
  _target_: agents.LinkClickDFSAgent
  fewshot: 5
  use_retry: true
  max_tries: 3
  max_actions: 50
  use_back: true
  use_feedback: true
  multiturn_demonstrations: false
  agent_description: "Assistant is a expert JSON builder designed to assist the user\
    \ in playing play the game of Wikispeedia. Assistant is familiar with all Wikipedia\
    \ pages and can help the user find a path between two Wikipedia articles.\n\n\
    This is a conversation between an Assistant and a User, playing the game of Wikispeedia.\
    \ \nUser: Here are the instructions for the game.\n{replace[instructions]}{replace[feedback_prefix]}\n\
    Assistant: {{\"response\": \"Understood. Let's start the game.\"}}\n{replace[fewshot_demonstrations]}\n"
  instructions: 'In Wikispeedia, given two Wikipedia articles, a source and a target,
    the goal is to reach the target article starting from the source article in as
    few clicks as possible. For the articles given this is always possible. The Assistant
    chooses the page that will take the user closer to the target, **only** from the
    provided candidates. If no available link takes you closer to the target, Assistant
    selects "NA" as the next page.


    ##Input

    The user input is in the JSON format as described below

    Input format:

    {"source": "<source article>", "target": "<target article>", "links": "<outgoing
    links from current article>"}


    ##Output

    The Assistant only responds in the JSON format as described below

    Output format:

    {"next_page": "<chosen page for user to click on>"}

    '
  user_initial_prefix: ''
  user_template: '{{"source": "{replace[src]}", "target": "{replace[tgt]}", "pages":
    "{replace[links]}"}}'
  assistant_prefix: '{"'
  demonstration_template: 'User: {replace[user_template]}

    Assistant: {{"next_page": "{replace[click]}"}}

    '
  demonstrations_file: ${data_dir}/wikispeedia/wikispeedia_paths-and-graph/fewshot_click_demonstrations.tsv
  agent_runs_file: ${agent_runs_file}

